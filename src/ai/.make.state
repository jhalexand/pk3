	/opt/SUNWspro/bin/CC -g -DDEBUG -I/cs/src/pk3/include -I/usr/include/X11 -I/usr/dt/include -I/cs/include -c PKAIClient.h
.BUILT_LAST_MAKE_RUN:
clean:
	/usr/bin/rm -rf *.o core a.out Templates.DB ir.out \
		 pkaiclient 
depend:
	makedepend -I/cs/src/pk3/include -I/usr/include/X11 -I/usr/dt/include -I/cs/include PKAIClient.C PKAIClientMain.C
