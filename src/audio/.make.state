clean:
	/usr/bin/rm -rf *.o core a.out Templates.DB ir.out \
		  libpkaudio.so
.BUILT_LAST_MAKE_RUN:
libpkaudio.so:
	ld -G -o libpkaudio.so PKAudioClass.o PKAudioPlayer.o Templates.DB/*.o
backup:
	gtar czvf /cs/src/pk3/src/backups/audio/"`date '+%d%m%y_%H%M%S'`.tar.gz" \
		*.C *.h Makefile
